{
  "specVersion": "0.1.0",
  "manifest": {
    "id": "example-rpg.advanced",
    "title": "Example RPG Advanced Bundle",
    "datasetVersion": "0.1.0",
    "description": "A slightly richer CRGS bundle demonstrating grouped requirements and formula-based effects."
  },
  "profile": {
    "id": "example.profile.demo",
    "name": "Example RPG",
    "version": "0.1.0",
    "specVersion": "0.1.0",
    "extensions": {
      "entityTypes": [
        {
          "id": "example.entity.trait",
          "schema": "https://example.crgs.dev/schema/entities/trait.schema.json"
        },
        {
          "id": "example.entity.selection",
          "schema": "https://example.crgs.dev/schema/entities/selection.schema.json"
        }
      ],
      "requirementTypes": [
        {
          "id": "example.requirement.attribute-rating",
          "schema": "https://example.crgs.dev/schema/requirements/attribute-rating.schema.json"
        },
        {
          "id": "example.requirement.skill-rating",
          "schema": "https://example.crgs.dev/schema/requirements/skill-rating.schema.json"
        }
      ],
      "effectTypes": [
        {
          "id": "example.effect.grant",
          "schema": "https://example.crgs.dev/schema/effects/grant.schema.json"
        },
        {
          "id": "example.effect.increase",
          "schema": "https://example.crgs.dev/schema/effects/increase.schema.json"
        }
      ],
      "relationTypes": [
        {
          "id": "example.relation.grants",
          "schema": "https://example.crgs.dev/schema/relations/grants.schema.json"
        },
        {
          "id": "example.relation.depends-on",
          "schema": "https://example.crgs.dev/schema/relations/depends-on.schema.json"
        }
      ]
    }
  },
  "entities": [
    {
      "id": "ancestry.human",
      "type": "example.entity.trait",
      "label": {
        "default": "Human"
      }
    },
    {
      "id": "background.scholar",
      "type": "example.entity.trait",
      "label": {
        "default": "Scholar"
      }
    },
    {
      "id": "feature.linguist",
      "type": "example.entity.trait",
      "label": {
        "default": "Linguist"
      },
      "requirements": {
        "kind": "group",
        "mode": "all",
        "children": [
          {
            "kind": "fact",
            "fact": "selected:ancestry",
            "operator": "equals",
            "value": "ancestry.human"
          },
          {
            "kind": "group",
            "mode": "any",
            "children": [
              {
                "kind": "fact",
                "fact": "selected:background",
                "operator": "equals",
                "value": "background.scholar"
              },
              {
                "kind": "fact",
                "fact": "profile:demo-mode",
                "operator": "present"
              }
            ]
          }
        ]
      },
      "effects": [
        {
          "type": "example.effect.increase",
          "target": "resource.language-slots",
          "operation": "increase",
          "value": 1
        },
        {
          "type": "example.effect.increase",
          "target": "formula.language-slots",
          "operation": "set",
          "formula": "baseLanguages + 1"
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "rel.scholar-supports-linguist",
      "type": "example.relation.depends-on",
      "from": "feature.linguist",
      "to": "background.scholar"
    },
    {
      "id": "rel.human-supports-linguist",
      "type": "example.relation.depends-on",
      "from": "feature.linguist",
      "to": "ancestry.human"
    }
  ],
  "metadata": {
    "tags": ["example", "advanced"]
  }
}
