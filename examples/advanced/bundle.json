{
  "specVersion": "0.1.0",
  "manifest": {
    "id": "example-rpg.advanced",
    "title": "Example RPG Advanced Bundle",
    "datasetVersion": "0.1.0",
    "description": "A slightly richer CRGS bundle demonstrating grouped requirements and formula-based effects."
  },
  "profile": {
    "id": "example-rpg",
    "name": "Example RPG",
    "version": "0.1.0",
    "specVersion": "0.1.0",
    "extensions": {
      "entityTypes": ["trait", "selection"],
      "requirementTypes": ["fact", "group"],
      "effectTypes": ["grant", "increase"],
      "relationshipTypes": ["grants", "depends-on"]
    }
  },
  "entities": [
    {
      "id": "ancestry.human",
      "type": "trait",
      "label": {
        "default": "Human"
      }
    },
    {
      "id": "background.scholar",
      "type": "trait",
      "label": {
        "default": "Scholar"
      }
    },
    {
      "id": "feature.linguist",
      "type": "trait",
      "label": {
        "default": "Linguist"
      },
      "requirements": {
        "kind": "group",
        "mode": "all",
        "children": [
          {
            "kind": "fact",
            "fact": "selected:ancestry",
            "operator": "equals",
            "value": "ancestry.human"
          },
          {
            "kind": "group",
            "mode": "any",
            "children": [
              {
                "kind": "fact",
                "fact": "selected:background",
                "operator": "equals",
                "value": "background.scholar"
              },
              {
                "kind": "fact",
                "fact": "profile:demo-mode",
                "operator": "present"
              }
            ]
          }
        ]
      },
      "effects": [
        {
          "type": "increase",
          "target": "resource.language-slots",
          "operation": "increase",
          "value": 1
        },
        {
          "type": "set",
          "target": "formula.language-slots",
          "operation": "set",
          "formula": "baseLanguages + 1"
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "rel.scholar-supports-linguist",
      "type": "depends-on",
      "from": "feature.linguist",
      "to": "background.scholar"
    },
    {
      "id": "rel.human-supports-linguist",
      "type": "depends-on",
      "from": "feature.linguist",
      "to": "ancestry.human"
    }
  ],
  "metadata": {
    "tags": ["example", "advanced"]
  }
}
