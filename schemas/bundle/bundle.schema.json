{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crgs.dev/schema/bundle/bundle.schema.json",
  "title": "Bundle",
  "description": "Transport unit containing dataset identity, profile declaration, entities, relations, and optional metadata.",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "manifest": {
      "$ref": "https://crgs.dev/schema/bundle/dataset-manifest.schema.json"
    },
    "profile": {
      "$ref": "https://crgs.dev/schema/profile/profile-manifest.schema.json"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "https://crgs.dev/schema/entities/entity.schema.json"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://crgs.dev/schema/relations/relation.schema.json"
      }
    },
    "metadata": {
      "$ref": "https://crgs.dev/schema/common/metadata.schema.json"
    }
  },
  "required": [
    "specVersion",
    "manifest",
    "profile",
    "entities",
    "relationships"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "specVersion": "0.1.0",
      "manifest": {
        "id": "example-rpg.minimal",
        "title": "Example RPG Minimal Bundle",
        "datasetVersion": "0.1.0"
      },
      "profile": {
        "id": "example-rpg",
        "name": "Example RPG",
        "version": "0.1.0",
        "specVersion": "0.1.0",
        "extensions": {
          "entityTypes": [
            {
              "id": "example.entity.trait",
              "schema": "https://example.crgs.dev/schema/entities/trait.schema.json"
            }
          ],
          "requirementTypes": [
            {
              "id": "example.requirement.attribute-rating",
              "schema": "https://example.crgs.dev/schema/requirements/attribute-rating.schema.json"
            }
          ],
          "effectTypes": [
            {
              "id": "example.effect.grant",
              "schema": "https://example.crgs.dev/schema/effects/grant.schema.json"
            }
          ],
          "relationTypes": [
            {
              "id": "example.relation.grants",
              "schema": "https://example.crgs.dev/schema/relations/grants.schema.json"
            }
          ]
        }
      },
      "entities": [
        {
          "id": "ancestry.human",
          "type": "example.entity.trait",
          "label": {
            "default": "Human"
          }
        }
      ],
      "relationships": [
        {
          "id": "rel.human-grants-adaptable",
          "type": "example.relation.grants",
          "from": "ancestry.human",
          "to": "feature.adaptable"
        }
      ]
    }
  ]
}
