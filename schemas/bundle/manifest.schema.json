{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crgs.dev/schema/bundle/manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    }
  },
  "required": ["id", "title", "datasetVersion"],
  "additionalProperties": false
}
