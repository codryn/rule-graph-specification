{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codryn.com/crgs/v0.1/requirements/requirement-expression.schema.json",
  "title": "RequirementExpression",
  "description": "Declarative predicate tree composed of atomic fact requirements and logical requirement groups.",
  "type": "object",
  "required": ["kind"],
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "$ref": "https://schemas.codryn.com/crgs/v0.1/requirements/atomic-requirement.schema.json"
    },
    {
      "$ref": "https://schemas.codryn.com/crgs/v0.1/requirements/requirement-group.schema.json"
    }
  ],
  "examples": [
    {
      "kind": "group",
      "mode": "all",
      "children": [
        {
          "kind": "fact",
          "fact": "selected:ancestry",
          "operator": "equals",
          "value": "ancestry.human"
        },
        {
          "kind": "fact",
          "fact": "profile:demo-mode",
          "operator": "present"
        }
      ]
    }
  ]
}
