{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crgs.dev/schema/common/localized-text.schema.json",
  "title": "LocalizedText",
  "type": "object",
  "properties": {
    "default": {
      "type": "string",
      "minLength": 1
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["default"],
  "additionalProperties": false
}
