{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codryn.com/crgs/v0.2/common/source-reference.schema.json",
  "title": "SourceReference",
  "description": "Structured provenance metadata that records the origin of a rule statement or graph element.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["title", "citation"],
  "additionalProperties": false,
  "examples": [
    {
      "title": "Core Rulebook",
      "citation": "Core Rulebook, p. 42",
      "locator": "p. 42",
      "url": "https://example.com/rules/core-rulebook"
    }
  ]
}
