{
  "name": "rule-graph-specification",
  "version": "0.1.0",
  "private": true,
  "description": "Codryn Rule Graph Specification repository tooling and scaffolding.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:markdown && npm run lint:code",
    "lint:code": "eslint .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "test": "vitest run",
    "validate": "node ./tools/validate-schemas.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "globals": "^16.3.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
