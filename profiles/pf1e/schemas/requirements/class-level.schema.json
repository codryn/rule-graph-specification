{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codryn.com/crgs/profiles/pf1e/v0.1/requirements/class-level.schema.json",
  "title": "PF1eClassLevelRequirement",
  "type": "object",
  "properties": {
    "kind": {
      "const": "pf1e.requirement.class-level"
    },
    "classId": {
      "type": "string",
      "pattern": "^pf1e\\.class\\.[a-z0-9-]+$"
    },
    "minimum": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["kind", "classId", "minimum"],
  "additionalProperties": false
}
