{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codryn.com/crgs/profiles/pf1e/v0.1/requirements/feat.schema.json",
  "title": "PF1eFeatRequirement",
  "type": "object",
  "properties": {
    "kind": {
      "const": "pf1e.requirement.feat"
    },
    "featId": {
      "type": "string",
      "pattern": "^pf1e\\.feat\\.[a-z0-9.-]+$"
    },
    "sameSelection": {
      "type": "boolean"
    }
  },
  "required": ["kind", "featId"],
  "additionalProperties": false
}
