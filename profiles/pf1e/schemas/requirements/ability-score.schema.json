{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codryn.com/crgs/profiles/pf1e/v0.1/requirements/ability-score.schema.json",
  "title": "PF1eAbilityScoreRequirement",
  "type": "object",
  "properties": {
    "kind": {
      "const": "pf1e.requirement.ability-score"
    },
    "ability": {
      "enum": ["str", "dex", "con", "int", "wis", "cha"]
    },
    "minimum": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["kind", "ability", "minimum"],
  "additionalProperties": false
}
