{
  "specVersion": "0.1.0",
  "manifest": {
    "id": "example-rpg.reference-slice",
    "title": "Example RPG Executable Reference Slice",
    "datasetVersion": "0.1.0",
    "description": "A synthetic CRGS reference bundle that exercises entities, requirements, relations, validation, graph generation, and evaluation."
  },
  "profile": {
    "id": "example.profile.demo",
    "name": "Example RPG",
    "version": "0.1.0",
    "specVersion": "0.1.0",
    "extensions": {
      "entityTypes": [
        {
          "id": "example.entity.attribute",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/entities/attribute.schema.json"
        },
        {
          "id": "example.entity.skill",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/entities/skill.schema.json"
        },
        {
          "id": "example.entity.ability",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/entities/ability.schema.json"
        },
        {
          "id": "example.entity.character",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/entities/character.schema.json"
        }
      ],
      "requirementTypes": [
        {
          "id": "example.requirement.attribute-rating",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/requirements/attribute-rating.schema.json"
        },
        {
          "id": "example.requirement.skill-rating",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/requirements/skill-rating.schema.json"
        }
      ],
      "effectTypes": [
        {
          "id": "example.effect.grant",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/effects/grant.schema.json"
        },
        {
          "id": "example.effect.increase",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/effects/increase.schema.json"
        }
      ],
      "relationTypes": [
        {
          "id": "example.relation.unlocks",
          "schema": "https://schemas.codryn.com/crgs/profiles/example/v0.1/relations/unlocks.schema.json"
        }
      ]
    }
  },
  "entities": [
    {
      "id": "example.attribute.strength",
      "type": "example.entity.attribute",
      "label": {
        "default": "Strength"
      }
    },
    {
      "id": "example.attribute.agility",
      "type": "example.entity.attribute",
      "label": {
        "default": "Agility"
      }
    },
    {
      "id": "example.attribute.intelligence",
      "type": "example.entity.attribute",
      "label": {
        "default": "Intelligence"
      }
    },
    {
      "id": "example.skill.athletics",
      "type": "example.entity.skill",
      "label": {
        "default": "Athletics"
      }
    },
    {
      "id": "example.skill.arcana",
      "type": "example.entity.skill",
      "label": {
        "default": "Arcana"
      }
    },
    {
      "id": "example.ability.powerful-strike",
      "type": "example.entity.ability",
      "label": {
        "default": "Powerful Strike"
      },
      "requirements": {
        "kind": "fact",
        "fact": "attribute:strength",
        "operator": "atLeast",
        "value": 3
      }
    },
    {
      "id": "example.ability.cleaving-strike",
      "type": "example.entity.ability",
      "label": {
        "default": "Cleaving Strike"
      },
      "requirements": {
        "kind": "crgs.requirement.entity",
        "targetId": "example.ability.powerful-strike"
      }
    },
    {
      "id": "example.ability.arcane-training",
      "type": "example.entity.ability",
      "label": {
        "default": "Arcane Training"
      },
      "requirements": {
        "kind": "group",
        "mode": "all",
        "children": [
          {
            "kind": "fact",
            "fact": "attribute:intelligence",
            "operator": "atLeast",
            "value": 3
          },
          {
            "kind": "fact",
            "fact": "skill:arcana",
            "operator": "atLeast",
            "value": 2
          }
        ]
      }
    },
    {
      "id": "example.ability.battle-mage",
      "type": "example.entity.ability",
      "label": {
        "default": "Battle Mage"
      },
      "requirements": {
        "kind": "group",
        "mode": "all",
        "children": [
          {
            "kind": "crgs.requirement.entity",
            "targetId": "example.ability.powerful-strike"
          },
          {
            "kind": "crgs.requirement.entity",
            "targetId": "example.ability.arcane-training"
          },
          {
            "kind": "fact",
            "fact": "character:level",
            "operator": "atLeast",
            "value": 5
          }
        ]
      }
    },
    {
      "id": "character.example-hero",
      "type": "example.entity.character",
      "label": {
        "default": "Example Hero"
      }
    }
  ],
  "relationships": [
    {
      "id": "rel.powerful-strike-unlocks-cleaving-strike",
      "type": "example.relation.unlocks",
      "from": "example.ability.powerful-strike",
      "to": "example.ability.cleaving-strike"
    },
    {
      "id": "rel.powerful-strike-unlocks-battle-mage",
      "type": "example.relation.unlocks",
      "from": "example.ability.powerful-strike",
      "to": "example.ability.battle-mage"
    },
    {
      "id": "rel.arcane-training-unlocks-battle-mage",
      "type": "example.relation.unlocks",
      "from": "example.ability.arcane-training",
      "to": "example.ability.battle-mage"
    }
  ]
}
